APP_PORT=8000
LOG_LEVEL=INFO
LOG_FILE=/app/logs/homey-ai-proxy.log

CONFIG_PATH=/app/config.yaml
PROXY_API_KEY=

HOMEY_BASE_URL=http://10.5.2.201
HOMEY_TOKEN=replace-with-your-homey-token
HOMEY_USE_MOCK=true
HOMEY_TRANSPORT=local
HOMEY_AUTH_MODE=static_token
HOMEY_OAUTH_CLIENT_ID=
HOMEY_OAUTH_CLIENT_SECRET=
HOMEY_OAUTH_REFRESH_TOKEN=
HOMEY_OAUTH_ACCESS_TOKEN=
HOMEY_MAX_REQUESTS_PER_MINUTE=5

CACHE_TTL_SECONDS=60
COMMAND_DEBOUNCE_SECONDS=10
HOMEY_RETRY_ATTEMPTS=3
HOMEY_RETRY_BASE_DELAY_SECONDS=0.5

OPENAI_ENABLED=false
OPENAI_API_KEY=
